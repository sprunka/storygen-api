{
  "name": "sprunka/story-prompt-generator",
  "description": "A RESTful PHP API service that delivers randomized story prompts by combining elements—characters, settings, events, objects—based on a flexible JSON schema.",
  "license": "MIT",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Sean Prunka",
      "email": "sprunka@gmail.com"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^12.2.2",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.10"
  },
  "require": {
    "slim/slim": "^4.14.0",
    "slim/psr7": "^1.7.1",
    "php-di/php-di": "^7.0.11",
    "selective/basepath": "^2.3.0",
    "zircote/swagger-php": "^3.3"
  },
  "autoload": {
    "psr-4": {
      "StoryGen\\": "src/StoryGen/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8080 -t public",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "phpstan": "phpstan analyse --memory-limit=256M",
    "analyse": [
      "@cs-check",
      "@phpstan"
    ],
    "benchmark": "php src/StoryGen/Scripts/BenchmarkEndpoints.php"
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true
  }
}
